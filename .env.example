# Access words for the site — any one of them opens everything. Not per room.
# Comment this out (or leave it empty) for an open site with no password.
SYNC_PASSWORDS=changeme

# Where the app keeps its room registry and (optionally) reads the words from a file.
# SYNC_PASSWORDS_FILE=/run/secrets/words

# Optional
# PORT=8080
# MEDIA_DIR=/media
# DATA_DIR=/data
# MAX_UPLOAD_BYTES=4294967296
