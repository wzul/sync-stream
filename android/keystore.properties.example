# Copy to keystore.properties and fill in to get a signed release build.
# Generate a key with:
#   keytool -genkeypair -v -keystore ks.jks -alias syncstream \
#     -keyalg RSA -keysize 4096 -validity 10000 -storetype PKCS12
storeFile=ks.jks
storePassword=changeit
keyAlias=syncstream
keyPassword=changeit
